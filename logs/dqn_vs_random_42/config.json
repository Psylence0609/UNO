{
  "training": {
    "episodes": 1000,
    "batch_size": 32,
    "learning_rate": 0.001,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.01,
    "epsilon_decay": 0.995,
    "memory_size": 5000,
    "target_update_freq": 500
  },
  "dqn": {
    "hidden_layers": [
      256,
      128
    ],
    "activation": "relu",
    "dropout": 0.1,
    "dueling": true,
    "double_dqn": true
  },
  "dmc": {
    "simulations": 1000,
    "exploration_weight": 1.4,
    "hidden_layers": [
      512,
      256
    ]
  },
  "mcts": {
    "num_simulations": 100,
    "exploration_constant": 1.414,
    "max_depth": 50
  },
  "environment": {
    "game": "uno",
    "num_players": 2,
    "seed": 42
  },
  "evaluation": {
    "eval_episodes": 200,
    "eval_freq": 200,
    "opponents": [
      "random",
      "rule_based"
    ]
  },
  "logging": {
    "log_level": "INFO",
    "log_dir": "./logs",
    "tensorboard": true,
    "wandb": false,
    "save_freq": 500
  },
  "paths": {
    "models": "./models",
    "logs": "./logs",
    "experiments": "./experiments"
  }
}